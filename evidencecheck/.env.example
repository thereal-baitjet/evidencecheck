# EvidenceCheck Environment Variables
# Copy to .env and fill in actual values (never commit .env)

# TypeSafe Jev Integration (optional)
# Get your API key from https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Jev Configuration
# Enable live Jev review (set to "true" to enable; requires API_KEY)
JEV_ENABLED=false

# Confidence threshold for review gate (0.0-1.0)
# Below this confidence, extractions are flagged for human review
JEV_CONFIDENCE_THRESHOLD=0.75

# Budget and rate limiting
JEV_MAX_REQUESTS_PER_RUN=100
JEV_TIMEOUT_SECONDS=30

# Development/Demo Mode
# Set to "true" to use synthetic fixtures instead of real PubMed data
DEMO_MODE=true

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Optional: NCBI/PubMed API
# For live PubMed queries (not used in offline mode)
NCBI_EMAIL=
NCBI_API_KEY=
